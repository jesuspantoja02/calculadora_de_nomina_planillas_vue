# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5174
# Base de datos SQLite (se crea sola al iniciar)
DATABASE_FILE=data/nomina.db
# Peticiones máximas por IP cada 15 minutos
RATE_LIMIT_MAX=300
# Firma de tokens de sesión (mín. 16 caracteres; cambiar en producción)
AUTH_SECRET=dev-nomina-auth-secret-cambiar-en-prod
# Duración del token en horas
AUTH_TOKEN_TTL_HOURS=12
# Código para restablecer contraseña de admin sin sesión (mín. 16 caracteres; vacío = deshabilitado)
AUTH_ADMIN_RECOVERY_SECRET=

# Asistente IA (opcional). Prioridad: Gemini → OpenAI → Ollama → motor local.
# Gemini gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
